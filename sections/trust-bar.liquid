<section class="trust-bar section-padding-tight" {{ section.shopify_attributes }}>
  <div class="page-width trust-bar__inner" data-reveal-group>
    {%- for block in section.blocks -%}
      <div class="trust-bar__item" data-reveal="fade" {{ block.shopify_attributes }}>
        {% render 'icon', icon: block.settings.icon %}
        <span>{{ block.settings.label }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.trust-bar__inner {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: clamp(1.5rem, 1rem + 2vw, 4rem);
}

.trust-bar__item {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--color-text-muted);
}

.trust-bar__item .icon {
  width: 1.2rem;
  height: 1.2rem;
  color: var(--color-accent);
}
{% endstylesheet %}

{% schema %}
{
  "name": "Bande de réassurance",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "item",
      "name": "Élément",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "image", "label": "Photo" },
            { "value": "video", "label": "Vidéo" },
            { "value": "gift", "label": "Cadeau" },
            { "value": "truck", "label": "Livraison" },
            { "value": "shield", "label": "Sécurité" },
            { "value": "refresh", "label": "Retour" },
            { "value": "frame", "label": "Cadre" },
            { "value": "star", "label": "Étoile" }
          ],
          "default": "image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Texte",
          "default": "Photos et vidéos"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "icon": "image", "label": "Photos et vidéos" } },
      { "type": "item", "settings": { "icon": "gift", "label": "Prêt à offrir" } },
      { "type": "item", "settings": { "icon": "frame", "label": "Facile à personnaliser" } },
      { "type": "item", "settings": { "icon": "truck", "label": "Expédié sous 3 jours" } }
    ]
  }
}
{% endschema %}
