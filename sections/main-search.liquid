{{ 'component-card.css' | asset_url | stylesheet_tag }}

<section class="search-page page-width section-padding" {{ section.shopify_attributes }}>
  <div class="search-page__header" data-reveal="fade">
    <h1 class="search-page__title font-heading">{{ 'general.search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <input type="hidden" name="type" value="product,article,page">
      <label for="SearchInput" class="visually-hidden">{{ 'general.search.title' | t }}</label>
      <input
        type="search"
        name="q"
        id="SearchInput"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
        autofocus
      >
      <button type="submit" class="icon-link" aria-label="{{ 'general.search.submit' | t }}">
        {% render 'icon', icon: 'search' %}
      </button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <p class="search-page__results-count text-muted">{{ 'general.search.results_for_html' | t: terms: search.terms }}</p>
      {%- paginate search.results by 20 -%}
        <div class="grid grid--4col" data-reveal-group>
          {%- for item in search.results -%}
            <div data-reveal="fade">
              {%- if item.object_type == 'product' -%}
                {%- render 'product-card', product: item -%}
              {%- else -%}
                <a href="{{ item.url }}" class="search-page__other-result">
                  <span class="badge">{{ item.object_type | capitalize }}</span>
                  <h3>{{ item.title }}</h3>
                  <p class="text-muted">{{ item.content | strip_html | truncate: 120 }}</p>
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="pagination__link">{% render 'icon', icon: 'chevron-left' %}</a>{%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}" class="pagination__link">{{ part.title }}</a>{%- else -%}<span class="pagination__link is-current">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="pagination__link">{% render 'icon', icon: 'chevron-right' %}</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <p class="search-page__empty">{{ 'general.search.no_results_html' | t: terms: search.terms }}</p>
    {%- endif -%}
  {%- endif -%}
</section>

{% stylesheet %}
.search-page__header {
  max-width: 34rem;
  margin-inline: auto;
  text-align: center;
  margin-bottom: clamp(2rem, 1.6rem + 1.6vw, 3.5rem);
}

.search-page__title {
  font-size: clamp(1.9rem, 1.6rem + 1.2vw, 2.6rem);
  margin-bottom: 1.25rem;
}

.search-page__form {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-input);
  padding: 0.4rem 0.4rem 0.4rem 1.1rem;
}

.search-page__form input[type="search"] {
  flex: 1;
  border: none;
  background: none;
  font-size: 1rem;
}

.search-page__form input[type="search"]:focus {
  outline: none;
}

.search-page__results-count {
  margin-bottom: 1.5rem;
  text-align: center;
}

.search-page__empty {
  text-align: center;
  color: var(--color-text-muted);
  padding-block: 3rem;
}

.search-page__other-result {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  padding: 1.25rem;
  border: 1px solid var(--color-border);
  border-radius: 14px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Recherche",
  "settings": []
}
{% endschema %}
