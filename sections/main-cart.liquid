{{ 'component-cart.css' | asset_url | stylesheet_tag }}

<section class="cart-page page-width section-padding" data-cart-page-section data-section-id="{{ section.id }}" {{ section.shopify_attributes }}>
  <h1 class="cart-page__title font-heading">{{ 'cart.general.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page__form" data-cart-page-form>
      <div class="cart-page__layout">
        <ul class="cart-page__items" role="list">
          {%- for item in cart.items -%}
            {%- render 'cart-item', item: item, item_index: forloop.index -%}
          {%- endfor -%}
        </ul>

        <div class="cart-page__summary">
          {%- if settings.enable_free_shipping_bar -%}
            {%- render 'free-shipping-bar' -%}
          {%- endif -%}

          <div class="field">
            <label for="CartNote">{{ 'cart.general.note' | t }}</label>
            <textarea name="note" id="CartNote" rows="3">{{ cart.note }}</textarea>
          </div>

          <div class="cart-page__subtotal">
            <span>{{ 'cart.general.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="text-muted cart-page__taxes">{{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t }}</p>

          <button type="submit" name="checkout" class="button button--accent button--full">{{ 'cart.general.checkout' | t }}</button>
          <a href="{{ routes.all_products_collection_url }}" class="link cart-page__continue">{{ 'cart.general.continue_shopping' | t }}</a>
        </div>
      </div>
    </form>
  {%- else -%}
    <div class="cart-page__empty">
      <p>{{ 'cart.general.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button button--secondary">{{ 'cart.general.empty_link' | t }}</a>
    </div>
  {%- endif -%}
</section>

<script src="{{ 'cart-page.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
.cart-page__title {
  font-size: clamp(1.9rem, 1.6rem + 1.2vw, 2.6rem);
  margin-bottom: 1.75rem;
}

.cart-page__layout {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: clamp(2rem, 1.5rem + 2vw, 4rem);
  align-items: flex-start;
}

.cart-page__items {
  display: flex;
  flex-direction: column;
}

.cart-page__summary {
  background: var(--color-background-alt);
  border-radius: 16px;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  position: sticky;
  top: 6rem;
}

.cart-page__subtotal {
  display: flex;
  justify-content: space-between;
  font-size: 1.15rem;
  font-weight: 600;
}

.cart-page__taxes {
  font-size: 0.8rem;
  margin-top: -0.5rem;
}

.cart-page__continue {
  text-align: center;
  font-size: 0.88rem;
}

.cart-page__empty {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1.5rem;
  padding-block: 3rem;
}

@media screen and (max-width: 900px) {
  .cart-page__layout {
    grid-template-columns: 1fr;
  }
  .cart-page__summary {
    position: static;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Panier",
  "settings": []
}
{% endschema %}
