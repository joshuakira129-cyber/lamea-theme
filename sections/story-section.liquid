<section class="story" data-story-section {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-intro" data-reveal="fade">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-heading font-heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="story__layout">
      <div class="story__frame-wrap hide-mobile">
        <div class="story__frame">
          {%- for block in section.blocks -%}
            <div class="story__frame-media aspect-ratio{% if forloop.first %} is-active{% endif %}" data-story-media data-story-index="{{ forloop.index0 }}">
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: loop: true, muted: true, autoplay: forloop.first, controls: false, image_size: '900x' }}
              {%- elsif block.settings.image -%}
                <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
              {%- else -%}
                <span class="placeholder-media">LAMEA_STORY_{{ forloop.index }}_PLACEHOLDER</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="story__moments">
        {%- for block in section.blocks -%}
          <div class="story__moment" data-story-trigger data-story-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="aspect-ratio story__moment-media hide-desktop">
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: loop: true, muted: true, autoplay: false, controls: false, image_size: '700x' }}
              {%- elsif block.settings.image -%}
                <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
              {%- else -%}
                <span class="placeholder-media">LAMEA_STORY_{{ forloop.index }}_PLACEHOLDER</span>
              {%- endif -%}
            </div>
            <p class="eyebrow">{{ block.settings.eyebrow }}</p>
            <h3 class="story__moment-title font-heading">{{ block.settings.heading }}</h3>
            <p class="story__moment-text text-muted">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'story-scroll.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
.story__layout {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: clamp(2rem, 1.5rem + 2vw, 5rem);
  margin-top: clamp(2rem, 1.6rem + 1.6vw, 3.5rem);
}

.story__frame-wrap {
  position: relative;
}

.story__frame {
  position: sticky;
  top: 6rem;
  border-radius: 20px;
  overflow: hidden;
  background: var(--color-background-alt);
}

.story__frame-media {
  aspect-ratio: 4/5;
  opacity: 0;
  transition: opacity 0.7s ease;
}

.story__frame-media:not(.is-active) {
  position: absolute;
  inset: 0;
}

.story__frame-media.is-active {
  opacity: 1;
  position: relative;
}

.story__frame-media img,
.story__frame-media video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.story__moments {
  display: flex;
  flex-direction: column;
  gap: clamp(3.5rem, 3rem + 2vw, 7rem);
}

.story__moment {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  max-width: 44ch;
  opacity: 0.4;
  transition: opacity 0.5s ease;
}

.story__moment.is-active {
  opacity: 1;
}

.story__moment-media {
  aspect-ratio: 4/5;
  border-radius: 16px;
  overflow: hidden;
  margin-bottom: 0.75rem;
}

.story__moment-media img,
.story__moment-media video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.story__moment-title {
  font-size: 1.5rem;
}

.story__moment-text {
  font-size: 0.98rem;
}

@media screen and (max-width: 989px) {
  .story__layout {
    grid-template-columns: 1fr;
  }
  .story__moment {
    opacity: 1;
    max-width: none;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Souvenirs animés",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Une histoire, plusieurs souvenirs" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Parce que certains moments méritent plus qu'une place dans votre téléphone." }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Vidéo (facultative, prioritaire sur l'image)" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Le premier rendez-vous" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Le sourire que vous n'avez jamais oublié" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "LAMEA garde ce moment vivant, prêt à être revécu chaque jour." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "moment", "settings": {} },
      { "type": "moment", "settings": { "eyebrow": "Le voyage à deux", "heading": "Cette lumière, ce jour-là", "text": "Une vidéo de quelques secondes qui dit tout." } },
      { "type": "moment", "settings": { "eyebrow": "Le quotidien", "heading": "Les petits riens qui comptent", "text": "Vos souvenirs méritent une place bien plus vivante qu'un tiroir." } }
    ]
  },
  "presets": [{ "name": "Souvenirs animés" }]
}
{% endschema %}
