{{ 'component-cart.css' | asset_url | stylesheet_tag }}
<cart-drawer id="CartDrawer" class="cart-drawer" data-open="false" data-cart-type="{% if settings.cart_type_drawer %}drawer{% else %}page{% endif %}">
  <div class="cart-drawer__overlay" data-cart-drawer-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title font-heading">{{ 'cart.general.your_cart' | t: count: cart.item_count }}</h2>
      <button type="button" class="icon-link" data-cart-drawer-close aria-label="{{ 'cart.general.close_cart' | t }}">
        {% render 'icon', icon: 'close' %}
      </button>
    </div>

    {%- if settings.enable_free_shipping_bar -%}
      {%- render 'free-shipping-bar' -%}
    {%- endif -%}

    <div class="cart-drawer__body" data-cart-drawer-body>
      {%- if cart.item_count > 0 -%}
        <ul class="cart-drawer__items" role="list">
          {%- for item in cart.items -%}
            {%- render 'cart-item', item: item, item_index: forloop.index -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="cart-drawer__empty">
          <p>{{ 'cart.general.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="button button--secondary" data-cart-drawer-close>{{ 'cart.general.empty_link' | t }}</a>
        </div>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__footer">
        {%- if settings.enable_cart_upsell and settings.cart_upsell_product -%}
          {%- render 'cart-upsell', product: settings.cart_upsell_product -%}
        {%- endif -%}

        <div class="cart-drawer__subtotal">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <span data-cart-subtotal>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-drawer__note text-muted">{{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t }}</p>
        <a href="{{ routes.cart_url }}" class="button button--secondary button--full">{{ 'cart.general.title' | t }}</a>
        <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__checkout-form">
          <button type="submit" name="checkout" class="button button--accent button--full">{{ 'cart.general.checkout' | t }}</button>
        </form>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% stylesheet %}
.cart-drawer__overlay {
  position: fixed;
  inset: 0;
  background: rgba(28, 25, 23, 0.42);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s ease;
  z-index: 59;
}

cart-drawer[data-open="true"] .cart-drawer__overlay {
  opacity: 1;
  pointer-events: auto;
}

.cart-drawer__panel {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: min(92vw, 420px);
  background: var(--color-background);
  z-index: 60;
  display: flex;
  flex-direction: column;
  transform: translateX(100%);
  transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}

cart-drawer[data-open="true"] .cart-drawer__panel {
  transform: translateX(0);
}

.cart-drawer__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem 1.25rem 1rem;
  border-bottom: 1px solid var(--color-border);
}

.cart-drawer__title {
  font-size: 1.3rem;
}

.cart-drawer__body {
  flex: 1;
  overflow-y: auto;
  padding: 0.5rem 1.25rem;
}

.cart-drawer__items {
  display: flex;
  flex-direction: column;
}

.cart-drawer__empty {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1.25rem;
  padding: 2.5rem 0;
}

.cart-drawer__footer {
  padding: 1rem 1.25rem 1.5rem;
  border-top: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.cart-drawer__subtotal {
  display: flex;
  justify-content: space-between;
  font-size: 1.05rem;
  font-weight: 600;
}

.cart-drawer__note {
  font-size: 0.78rem;
  margin: -0.35rem 0 0.25rem;
}

.cart-drawer__checkout-form {
  margin: 0;
}

@media (prefers-reduced-motion: reduce) {
  .cart-drawer__panel,
  .cart-drawer__overlay {
    transition: none;
  }
}
{% endstylesheet %}
