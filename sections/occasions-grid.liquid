<section class="occasions section-padding" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-intro section-intro--center" data-reveal="fade">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-heading section-heading--center font-heading">{{ section.settings.heading }}</h2>
    </div>

    <div class="occasions__grid" data-reveal-group>
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="occasion-card hover-zoom" data-reveal="fade" {{ block.shopify_attributes }}>
          <div class="aspect-ratio occasion-card__media">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
            {%- else -%}
              <span class="placeholder-media">LAMEA_OCCASION_{{ forloop.index }}_PLACEHOLDER</span>
            {%- endif -%}
          </div>
          <span class="occasion-card__label">{{ block.settings.label }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.occasions__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--grid-gutter);
}

.occasion-card {
  position: relative;
  display: block;
  border-radius: 14px;
  overflow: hidden;
}

.occasion-card__media {
  aspect-ratio: 3/4;
  background: var(--color-background-alt);
}

.occasion-card__media::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(20,17,15,0) 40%, rgba(20,17,15,0.55) 100%);
}

.occasion-card__label {
  position: absolute;
  left: 1rem;
  right: 1rem;
  bottom: 1rem;
  color: #fff;
  font-weight: 600;
  font-size: 1.05rem;
  z-index: 1;
}

@media screen and (max-width: 749px) {
  .occasions__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Occasions",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pour chaque moment" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un cadeau pour chaque occasion" }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Nom", "default": "Anniversaire" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Occasions",
      "blocks": [
        { "type": "occasion", "settings": { "label": "Anniversaire" } },
        { "type": "occasion", "settings": { "label": "Saint-Valentin" } },
        { "type": "occasion", "settings": { "label": "Couple" } },
        { "type": "occasion", "settings": { "label": "Mariage" } },
        { "type": "occasion", "settings": { "label": "Longue distance" } },
        { "type": "occasion", "settings": { "label": "Noël" } }
      ]
    }
  ]
}
{% endschema %}
