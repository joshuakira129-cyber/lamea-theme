<section class="showcase section-padding" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-intro section-intro--center" data-reveal="fade">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-heading section-heading--center font-heading">{{ section.settings.heading }}</h2>
    </div>
  </div>

  {%- liquid
    assign linked_product = section.settings.linked_product
    assign is_video = false
    if section.settings.media_type == 'video' and section.settings.video != blank
      assign is_video = true
    endif
  -%}
  <div class="showcase__media hover-zoom" data-reveal="scale">
    {%- if linked_product != blank and is_video == false -%}<a href="{{ linked_product.url }}" aria-label="{{ 'products.product.view_details' | t }} — {{ linked_product.title }}">{%- endif -%}

    {%- if is_video -%}
      <div class="aspect-ratio showcase__media-inner">
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1920x' }}
      </div>
    {%- elsif section.settings.image -%}
      <div class="aspect-ratio showcase__media-inner">
        <img
          src="{{ section.settings.image | image_url: width: 1920 }}"
          srcset="{{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2200 }} 2200w"
          sizes="100vw"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      </div>
    {%- else -%}
      <div class="aspect-ratio showcase__media-inner">
        <span class="placeholder-media">LAMEA_PRODUCT_DEMO_PLACEHOLDER — vidéo ou image 16:9</span>
      </div>
    {%- endif -%}

    {%- if linked_product != blank and is_video == false -%}</a>{%- endif -%}

    {%- if linked_product != blank and is_video -%}
      <a href="{{ linked_product.url }}" class="showcase__cta button button--outline-light button--small">
        <span>{{ 'products.product.view_details' | t }}</span>
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.caption != blank -%}
    <div class="page-width">
      <p class="showcase__caption text-muted" data-reveal="fade">{{ section.settings.caption }}</p>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.showcase__media {
  position: relative;
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  border-radius: 20px;
  overflow: hidden;
}

.showcase__media > a {
  display: block;
  cursor: pointer;
}

.showcase__cta {
  position: absolute;
  left: 50%;
  bottom: 1.5rem;
  transform: translateX(-50%);
  backdrop-filter: blur(4px);
  background: rgba(28, 25, 23, 0.35);
}

.showcase__media-inner {
  aspect-ratio: 16/9;
}

.showcase__media-inner img,
.showcase__media-inner video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.showcase__caption {
  text-align: center;
  margin-top: 1.25rem;
  font-size: 0.9rem;
}

@media screen and (max-width: 749px) {
  .showcase__media {
    border-radius: 0;
  }
  .showcase__media-inner {
    aspect-ratio: 4/5;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Démonstration produit",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Voir LAMEA en action" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un cadre. Une histoire qui prend vie." },
    {
      "type": "select",
      "id": "media_type",
      "label": "Type de média",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Vidéo" }
      ],
      "default": "image"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Vidéo" },
    { "type": "text", "id": "caption", "label": "Légende (facultative)" },
    {
      "type": "product",
      "id": "linked_product",
      "label": "Produit associé",
      "info": "Si renseigné, l'image (ou un bouton sur la vidéo) devient cliquable vers la fiche produit."
    }
  ],
  "presets": [{ "name": "Démonstration produit" }]
}
{% endschema %}
