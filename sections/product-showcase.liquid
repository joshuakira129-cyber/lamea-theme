<section class="showcase section-padding" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-intro section-intro--center" data-reveal="fade">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-heading section-heading--center font-heading">{{ section.settings.heading }}</h2>
    </div>
  </div>

  {%- liquid
    assign linked_product = section.settings.linked_product
    assign is_video = false
    if section.settings.media_type == 'video' and section.settings.video != blank
      assign is_video = true
    endif

    assign showcase_image = section.settings.image
    if showcase_image == blank and linked_product != blank and linked_product.featured_image != blank
      assign showcase_image = linked_product.featured_image
    endif

    assign product_link = section.settings.product_link
    if product_link == blank and linked_product != blank
      assign product_link = linked_product.url
    endif
  -%}

  {%- if product_link != blank -%}<a href="{{ product_link }}" class="showcase__link" aria-label="{{ 'products.product.view_details' | t }}">{%- endif -%}

  <div class="showcase__media hover-zoom" data-reveal="scale">
    {%- if is_video -%}
      <div class="aspect-ratio showcase__media-inner">
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1920x' }}
      </div>
    {%- elsif showcase_image != blank -%}
      <div class="aspect-ratio showcase__media-inner">
        <img
          src="{{ showcase_image | image_url: width: 1920 }}"
          srcset="{{ showcase_image | image_url: width: 900 }} 900w, {{ showcase_image | image_url: width: 1600 }} 1600w, {{ showcase_image | image_url: width: 2200 }} 2200w"
          sizes="100vw"
          alt="{{ showcase_image.alt | default: linked_product.title | escape }}"
          width="{{ showcase_image.width }}"
          height="{{ showcase_image.height }}"
          loading="lazy"
        >
      </div>
    {%- else -%}
      <div class="aspect-ratio showcase__media-inner">
        <span class="placeholder-media">LAMEA_PRODUCT_DEMO_PLACEHOLDER — vidéo ou image 16:9</span>
      </div>
    {%- endif -%}

    {%- if product_link != blank and is_video -%}
      <span class="showcase__cta button button--outline-light button--small">
        <span>{{ 'products.product.view_details' | t }}</span>
      </span>
    {%- endif -%}
  </div>

  {%- if section.settings.show_price and section.settings.price_text != blank -%}
    <div class="page-width">
      <p class="showcase__price" data-reveal="fade">{{ section.settings.price_text }}</p>
    </div>
  {%- endif -%}

  {%- if product_link != blank -%}</a>{%- endif -%}

  {%- if section.settings.caption != blank -%}
    <div class="page-width">
      <p class="showcase__caption text-muted" data-reveal="fade">{{ section.settings.caption }}</p>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.showcase__media {
  position: relative;
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  border-radius: 20px;
  overflow: hidden;
}

.showcase__link {
  display: block;
  cursor: pointer;
}

.showcase__link:hover .showcase__price {
  text-decoration: underline;
  text-underline-offset: 4px;
}

.showcase__cta {
  position: absolute;
  left: 50%;
  bottom: 1.5rem;
  transform: translateX(-50%);
  backdrop-filter: blur(4px);
  background: rgba(28, 25, 23, 0.35);
}

.showcase__media-inner {
  aspect-ratio: 16/9;
}

.showcase__media-inner img,
.showcase__media-inner video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.showcase__price {
  text-align: center;
  margin-top: 1.5rem;
  font-size: 1.35rem;
  font-weight: 600;
  color: var(--color-accent);
  font-family: var(--font-heading-family);
}

.showcase__caption {
  text-align: center;
  margin-top: 0.5rem;
  font-size: 0.9rem;
}

@media screen and (max-width: 749px) {
  .showcase__media {
    border-radius: 0;
  }
  .showcase__media-inner {
    aspect-ratio: 4/5;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Démonstration produit",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Voir LAMEA en action" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un cadre. Une histoire qui prend vie." },
    {
      "type": "select",
      "id": "media_type",
      "label": "Type de média",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Vidéo" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (facultative)",
      "info": "Laissez vide pour utiliser automatiquement la photo principale du produit associé ci-dessous."
    },
    { "type": "video", "id": "video", "label": "Vidéo" },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Afficher le prix sous l'image",
      "default": true
    },
    {
      "type": "text",
      "id": "price_text",
      "label": "Prix affiché",
      "info": "Doit correspondre au prix réel du produit — mettez-le à jour si le prix change.",
      "default": "CHF 89.90"
    },
    { "type": "text", "id": "caption", "label": "Légende (facultative)" },
    {
      "type": "url",
      "id": "product_link",
      "label": "Lien vers le produit",
      "info": "Rend l'image ET le prix cliquables vers cette page. Collez ici le lien de votre produit (ex. /products/votre-produit)."
    },
    {
      "type": "product",
      "id": "linked_product",
      "label": "Produit associé (optionnel)",
      "info": "Sert uniquement à remplir automatiquement la photo si aucune image n'est choisie ci-dessus."
    }
  ],
  "presets": [{ "name": "Démonstration produit" }]
}
{% endschema %}
