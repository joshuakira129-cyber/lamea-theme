{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign recommendations_limit = section.settings.products_to_show
-%}
<section class="related-products section-padding" data-related-products-section {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="section-intro section-intro--center" data-reveal="fade">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="section-heading section-heading--center font-heading">{{ section.settings.heading }}</h2>
    </div>

    <product-recommendations
      class="grid grid--4col"
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&limit={{ recommendations_limit }}&product_id={{ product.id }}&intent=related"
    >
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- for card_product in recommendations.products -%}
          <div data-reveal="fade">
            {%- render 'product-card', product: card_product -%}
          </div>
        {%- endfor -%}
      {%- elsif product == blank -%}
        {%- for card_product in collections.all.products limit: recommendations_limit -%}
          <div data-reveal="fade">
            {%- render 'product-card', product: card_product -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </product-recommendations>
  </div>
</section>

{% javascript %}
class ProductRecommendations extends HTMLElement {
  connectedCallback() {
    var url = this.dataset.url;
    if (!url) return;
    fetch(url)
      .then(function (res) { return res.text(); })
      .then((text) => {
        var html = document.createElement("div");
        html.innerHTML = text;
        var recommendations = html.querySelector("product-recommendations");
        if (recommendations && recommendations.innerHTML.trim().length) {
          this.innerHTML = recommendations.innerHTML;
        } else {
          this.closest("[data-related-products-section]").remove();
        }
      })
      .catch(() => {});
  }
}
if (!customElements.get("product-recommendations")) {
  customElements.define("product-recommendations", ProductRecommendations);
}
{% endjavascript %}

{% schema %}
{
  "name": "Produits associés",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "À compléter" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Vous aimerez aussi" },
    { "type": "range", "id": "products_to_show", "label": "Nombre de produits", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Produits associés" }]
}
{% endschema %}
