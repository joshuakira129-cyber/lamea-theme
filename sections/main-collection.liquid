{{ 'component-card.css' | asset_url | stylesheet_tag }}

<section class="collection page-width section-padding" {{ section.shopify_attributes }}>
  <div class="collection__header" data-reveal="fade">
    <h1 class="collection__title font-heading">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection__description">{{ collection.description }}</div>
    {%- endif -%}
  </div>

  <div class="collection__toolbar">
    <p class="collection__count text-muted">
      {%- if collection.products_count == 1 -%}
        {{ 'collection.general.items_with_count.one' | t: count: collection.products_count }}
      {%- else -%}
        {{ 'collection.general.items_with_count.other' | t: count: collection.products_count }}
      {%- endif -%}
    </p>

    <form method="get" class="collection__sort" data-collection-sort>
      <label for="SortBy" class="visually-hidden">{{ 'collection.general.sort_by' | t }}</label>
      <select name="sort_by" id="SortBy" onchange="this.form.submit()">
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected="selected"{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </form>
  </div>

  {%- if collection.products.size > 0 -%}
    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="grid grid--4col" data-reveal-group>
        {%- for product in collection.products -%}
          <div data-reveal="fade">
            {%- render 'product-card', product: product -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="pagination__link">{% render 'icon', icon: 'chevron-left' %}</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="pagination__link">{{ part.title }}</a>
            {%- else -%}
              <span class="pagination__link{% if part.title == paginate.current_page %} is-current{% endif %}">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="pagination__link">{% render 'icon', icon: 'chevron-right' %}</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    <p class="collection__empty">{{ 'collection.general.empty' | t }}</p>
  {%- endif -%}
</section>

{% stylesheet %}
.collection__header {
  max-width: 44rem;
  margin-bottom: 1.5rem;
}

.collection__title {
  font-size: clamp(2rem, 1.7rem + 1.4vw, 2.9rem);
}

.collection__description {
  color: var(--color-text-muted);
  margin-top: 0.75rem;
}

.collection__toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.75rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--color-border);
}

.collection__sort select {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-input);
  padding: 0.5em 0.85em;
  background: var(--color-background);
}

.collection__empty {
  color: var(--color-text-muted);
  padding-block: 3rem;
  text-align: center;
}

{% endstylesheet %}

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Produits par page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    }
  ]
}
{% endschema %}
