<section class="simple-page page-width section-padding" {{ section.shopify_attributes }}>
  <div class="simple-page__header" data-reveal="fade">
    <h1 class="simple-page__title font-heading">{{ page.title }}</h1>
  </div>
  <div class="simple-page__content" data-reveal="fade">
    {{ page.content }}
  </div>
</section>

{% stylesheet %}
.simple-page__header {
  max-width: 44rem;
  margin-bottom: clamp(1.5rem, 1.2rem + 1vw, 2.5rem);
}

.simple-page__title {
  font-size: clamp(2rem, 1.7rem + 1.4vw, 2.9rem);
}

.simple-page__content {
  max-width: 44rem;
  color: var(--color-text-muted);
  font-size: 1.02rem;
  line-height: 1.75;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.simple-page__content h2 {
  color: var(--color-text);
  font-size: 1.4rem;
  margin-top: 1rem;
}

.simple-page__content a {
  text-decoration: underline;
  color: var(--color-text);
}
{% endstylesheet %}

{% schema %}
{
  "name": "Page",
  "settings": []
}
{% endschema %}
