<section class="final-cta" {{ section.shopify_attributes }}>
  <div class="final-cta__media" data-parallax-speed="0.05">
    {%- if section.settings.image -%}
      <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="{{ section.settings.image.alt | escape }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="lazy">
    {%- else -%}
      <span class="placeholder-media">LAMEA_FINAL_CTA_PLACEHOLDER</span>
    {%- endif -%}
    <div class="final-cta__scrim" aria-hidden="true"></div>
  </div>

  <div class="page-width final-cta__content" data-reveal="fade">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow" style="color:#f3e8e0;">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="final-cta__heading font-heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="final-cta__text">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="button button--accent">
        <span>{{ section.settings.cta_label }}</span>
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.final-cta {
  position: relative;
  min-height: 65vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #fff;
  overflow: hidden;
}

.final-cta__media {
  position: absolute;
  inset: 0;
  height: 110%;
  top: -5%;
}

.final-cta__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.final-cta__scrim {
  position: absolute;
  inset: 0;
  background: rgba(20, 17, 15, 0.5);
}

.final-cta__content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  max-width: 40rem;
  margin-inline: auto;
  padding-block: clamp(4rem, 3rem + 3vw, 6rem);
}

.final-cta__heading {
  font-size: clamp(2rem, 1.6rem + 2vw, 3.2rem);
}

.final-cta__text {
  color: rgba(255, 255, 255, 0.85);
  max-width: 42ch;
}
{% endstylesheet %}

{% schema %}
{
  "name": "CTA final",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image de fond" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Prêt à faire vivre vos souvenirs ?" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Offrez un souvenir qui prend vie" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Créez votre LAMEA en quelques minutes et surprenez la personne que vous aimez." },
    { "type": "text", "id": "cta_label", "label": "CTA — texte", "default": "Créer mon LAMEA" },
    { "type": "url", "id": "cta_link", "label": "CTA — lien" }
  ],
  "presets": [{ "name": "CTA final" }]
}
{% endschema %}
