<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {%- style -%}
      {%- render 'css-variables' -%}
    {%- endstyle -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- render 'font-face', font: settings.font_heading, css_variable: '--font-heading-family' -%}
    {%- render 'font-face', font: settings.font_body, css_variable: '--font-body-family' -%}
  </head>
  <body class="password-page">
    <main class="password-page__main">
      <div class="password-page__content">
        {%- if settings.logo -%}
          <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="120" height="{{ 120 | divided_by: settings.logo.aspect_ratio | default: 120 }}" class="password-page__logo">
        {%- else -%}
          <span class="font-heading password-page__wordmark">{{ shop.name }}</span>
        {%- endif -%}

        <p class="eyebrow">{{ 'general.password_page.opening_soon' | t }}</p>
        <h1 class="password-page__title font-heading">{{ shop.name }}</h1>
        <p class="password-page__tagline">Désormais, votre amour prend vie.</p>

        {%- if shop.password_message != blank -%}
          <div class="password-page__message">{{ shop.password_message }}</div>
        {%- endif -%}

        {%- form 'storefront_password' -%}
          {%- if form.errors -%}
            <p class="password-page__error" role="alert">{{ 'general.password_page.login_form_heading' | t }}</p>
          {%- endif -%}
          <div class="field">
            <label for="Password" class="visually-hidden">Mot de passe</label>
            <input type="password" name="password" id="Password" placeholder="Mot de passe">
          </div>
          <button type="submit" class="button button--accent button--full">{{ 'general.password_page.login_password_button' | t }}</button>
        {%- endform -%}

        {%- form 'customer', class: 'password-page__signup' -%}
          <input type="hidden" name="contact[tags]" value="prospect,password_page">
          <p class="password-page__signup-heading">{{ 'general.password_page.signup_form_heading' | t }}</p>
          <div class="field">
            <label for="SignupEmail" class="visually-hidden">Email</label>
            <input type="email" name="contact[email]" id="SignupEmail" placeholder="{{ 'general.newsletter.email_placeholder' | t }}" required>
          </div>
          <button type="submit" class="button button--secondary button--full">{{ 'general.newsletter.submit' | t }}</button>
          {%- if form.posted_successfully? -%}<p role="status">{{ 'general.newsletter.success' | t }}</p>{%- endif -%}
        {%- endform -%}

        <p class="password-page__admin">{{ 'general.password_page.admin_link_html' | t }}</p>
      </div>
    </main>
    {{ content_for_layout }}

    {%- style -%}
      .password-page {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--color-background);
        color: var(--color-text);
        font-family: var(--font-body-family);
      }
      .password-page__content {
        max-width: 26rem;
        width: 100%;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 0.85rem;
      }
      .password-page__logo { margin-bottom: 0.5rem; }
      .password-page__wordmark { font-size: 1.6rem; letter-spacing: 0.06em; }
      .password-page__title { font-size: 2.2rem; }
      .password-page__tagline { color: var(--color-text-muted); margin-bottom: 1rem; }
      .password-page__message { color: var(--color-text-muted); }
      .password-page form { width: 100%; display: flex; flex-direction: column; gap: 0.75rem; margin-top: 0.5rem; }
      .password-page__signup { border-top: 1px solid var(--color-border); padding-top: 1.5rem; margin-top: 1.5rem; }
      .password-page__signup-heading { font-size: 0.85rem; color: var(--color-text-muted); }
      .password-page__error { color: #b23b3b; font-size: 0.85rem; }
      .password-page__admin { font-size: 0.78rem; color: var(--color-text-muted); margin-top: 1rem; }
    {%- endstyle -%}
  </body>
</html>
