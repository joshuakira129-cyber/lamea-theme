[
  {
    "name": "theme_info",
    "theme_name": "LAMEA",
    "theme_version": "1.0.0",
    "theme_author": "LAMEA",
    "theme_documentation_url": "https://github.com/",
    "theme_support_url": "https://github.com/"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 260,
        "step": 5,
        "unit": "px",
        "label": "Largeur du logo (desktop)",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Couleurs",
    "settings": [
      {
        "type": "header",
        "content": "Fond & texte"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Fond principal",
        "default": "#FAF7F2"
      },
      {
        "type": "color",
        "id": "color_background_alt",
        "label": "Fond secondaire",
        "default": "#F1EBE1"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Texte principal",
        "default": "#1C1917"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Texte atténué",
        "default": "#6B645C"
      },
      {
        "type": "header",
        "content": "Accent & boutons"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Couleur d'accent",
        "default": "#7A2E32"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Texte sur accent",
        "default": "#FAF7F2"
      },
      {
        "type": "color",
        "id": "color_button_primary_bg",
        "label": "Bouton principal - fond",
        "default": "#1C1917"
      },
      {
        "type": "color",
        "id": "color_button_primary_text",
        "label": "Bouton principal - texte",
        "default": "#FAF7F2"
      },
      {
        "type": "header",
        "content": "Structure"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Bordures",
        "default": "#E4DDD1"
      },
      {
        "type": "color",
        "id": "color_header_bg",
        "label": "Fond du header",
        "default": "#FAF7F2"
      },
      {
        "type": "color",
        "id": "color_footer_bg",
        "label": "Fond du footer",
        "default": "#1C1917"
      },
      {
        "type": "color",
        "id": "color_footer_text",
        "label": "Texte du footer",
        "default": "#FAF7F2"
      }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      {
        "type": "header",
        "content": "Titres (éditorial)"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Police des titres",
        "default": "playfair_display_n4"
      },
      {
        "type": "header",
        "content": "Texte courant"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Police du texte",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Échelle des titres",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "label": "Échelle du texte",
        "default": 100
      }
    ]
  },
  {
    "name": "Mise en page",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Largeur maximale du site",
        "default": 1400
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Espacement entre sections",
        "default": 72
      },
      {
        "type": "range",
        "id": "grid_gutter",
        "min": 8,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Espacement des grilles",
        "default": 20
      }
    ]
  },
  {
    "name": "Boutons & formulaires",
    "settings": [
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "Rayon des boutons",
        "default": 4
      },
      {
        "type": "range",
        "id": "input_radius",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "label": "Rayon des champs de formulaire",
        "default": 2
      },
      {
        "type": "select",
        "id": "button_style",
        "label": "Style des boutons",
        "options": [
          { "value": "solid", "label": "Plein" },
          { "value": "outline", "label": "Contour" }
        ],
        "default": "solid"
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_animations",
        "label": "Activer les animations au scroll",
        "default": true
      },
      {
        "type": "select",
        "id": "animation_intensity",
        "label": "Intensité des animations",
        "options": [
          { "value": "subtle", "label": "Discrète" },
          { "value": "medium", "label": "Moyenne" },
          { "value": "expressive", "label": "Expressive" }
        ],
        "default": "medium"
      },
      {
        "type": "checkbox",
        "id": "enable_parallax",
        "label": "Activer les effets de parallax léger (desktop)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_hover_effects",
        "label": "Activer les effets au survol (desktop)",
        "default": true
      }
    ]
  },
  {
    "name": "Produit",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_product_reviews",
        "label": "Afficher les avis / étoiles",
        "info": "Nécessite une app d'avis connectée (ex: Shopify Product Reviews, Judge.me, Loox). N'affiche rien tant qu'aucune app n'est installée.",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_compare_at_price",
        "label": "Afficher le prix barré quand disponible",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_sticky_cart_mobile",
        "label": "Activer la barre d'achat fixe sur mobile",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_sticky_buy_box_desktop",
        "label": "Activer le panneau d'achat fixe au scroll (desktop)",
        "default": true
      },
      {
        "type": "text",
        "id": "payment_badges_text",
        "label": "Texte au-dessus des moyens de paiement",
        "default": "Paiement 100% sécurisé"
      },
      {
        "type": "header",
        "content": "Personnalisation photos / vidéos"
      },
      {
        "type": "checkbox",
        "id": "enable_media_upload",
        "label": "Activer le module d'upload de souvenirs sur la fiche produit",
        "default": true
      },
      {
        "type": "text",
        "id": "upload_provider",
        "label": "Fournisseur d'upload (identifiant technique)",
        "info": "Voir README.md section « Upload de médias ». Valeurs possibles selon l'intégration branchée : none, cloudinary, external-form. Ne pas modifier sans avoir suivi la doc.",
        "default": "none"
      },
      {
        "type": "text",
        "id": "upload_endpoint_url",
        "label": "URL du service d'upload externe",
        "info": "Laisser vide tant qu'aucun service n'est branché."
      },
      {
        "type": "number",
        "id": "upload_max_files",
        "label": "Nombre maximum de fichiers",
        "default": 10
      }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_type_drawer",
        "label": "Utiliser le panier latéral (drawer)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_free_shipping_bar",
        "label": "Activer la barre de livraison gratuite",
        "default": false
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Seuil de livraison gratuite",
        "default": 100
      },
      {
        "type": "checkbox",
        "id": "enable_cart_upsell",
        "label": "Activer la suggestion de produit dans le panier",
        "default": false
      },
      {
        "type": "product",
        "id": "cart_upsell_product",
        "label": "Produit suggéré dans le panier"
      }
    ]
  },
  {
    "name": "Réseaux sociaux",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram (URL)" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok (URL)" },
      { "type": "text", "id": "social_facebook", "label": "Facebook (URL)" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest (URL)" },
      { "type": "text", "id": "social_youtube", "label": "YouTube (URL)" }
    ]
  },
  {
    "name": "SEO & réseaux",
    "settings": [
      {
        "type": "textarea",
        "id": "seo_default_description",
        "label": "Meta description par défaut"
      },
      {
        "type": "image_picker",
        "id": "social_share_image",
        "label": "Image de partage par défaut (Open Graph)"
      }
    ]
  }
]
