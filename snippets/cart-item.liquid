{%- comment -%}
  Renders one cart line item. Used by sections/cart-drawer.liquid and
  sections/main-cart.liquid.
  Accepts: item, item_index
{%- endcomment -%}
<li class="cart-item" data-cart-item data-line="{{ item_index }}">
  <a href="{{ item.url }}" class="cart-item__media aspect-ratio" style="aspect-ratio: 1/1;">
    {%- if item.image -%}
      <img
        src="{{ item.image | image_url: width: 200 }}"
        alt="{{ item.image.alt | escape }}"
        width="100"
        height="100"
        loading="lazy"
      >
    {%- else -%}
      <span class="placeholder-media">LAMEA_PRODUCT_FRONT_PLACEHOLDER</span>
    {%- endif -%}
  </a>

  <div class="cart-item__details">
    <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>

    {%- if item.variant.title != 'Default Title' -%}
      <p class="cart-item__variant text-muted">{{ item.variant.title }}</p>
    {%- endif -%}

    {%- assign visible_properties = '' -%}
    {%- for property in item.properties -%}
      {%- unless property.first contains '_' or property.last == blank -%}
        {%- assign visible_properties = visible_properties | append: '1' -%}
      {%- endunless -%}
    {%- endfor -%}

    {%- if visible_properties != blank -%}
      <details class="cart-item__personalization">
        <summary>{{ 'cart.item.personalization' | t }}</summary>
        <ul>
          {%- for property in item.properties -%}
            {%- unless property.first contains '_' or property.last == blank -%}
              <li>
                <span>{{ property.first }}:</span>
                {%- if property.last contains '://' -%}
                  <a href="{{ property.last }}" target="_blank" rel="noopener">{{ 'cart.item.files_attached' | t: count: 1 }}</a>
                {%- else -%}
                  {{ property.last }}
                {%- endif -%}
              </li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>
      </details>
    {%- endif -%}

    <div class="cart-item__row">
      <quantity-input class="quantity-input quantity-input--small" data-line="{{ item_index }}">
        <button type="button" name="minus" aria-label="{{ 'products.product.quantity.decrease' | t }}">{% render 'icon', icon: 'minus' %}</button>
        <input
          type="number"
          name="updates[]"
          value="{{ item.quantity }}"
          min="0"
          aria-label="{{ 'products.product.quantity.label' | t }}"
          data-cart-quantity-input
          data-line="{{ item_index }}"
        >
        <button type="button" name="plus" aria-label="{{ 'products.product.quantity.increase' | t }}">{% render 'icon', icon: 'plus' %}</button>
      </quantity-input>

      <a href="{{ routes.cart_change_url }}?line={{ item_index }}&quantity=0" class="cart-item__remove link link--muted" data-cart-remove data-line="{{ item_index }}">
        {{ 'cart.general.remove' | t }}
      </a>
    </div>
  </div>

  <div class="cart-item__price">
    {{ item.final_line_price | money }}
  </div>
</li>
