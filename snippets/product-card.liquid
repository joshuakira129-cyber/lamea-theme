{%- comment -%}
  Accepts: product, image_ratio (optional, default '4/5')
{%- endcomment -%}
<div class="product-card">
  <a href="{{ product.url }}" class="product-card__media-link hover-zoom">
    <div class="aspect-ratio product-card__media" style="aspect-ratio: {{ image_ratio | default: '4/5' }};">
      {%- if product.featured_media -%}
        <img
          src="{{ product.featured_media | image_url: width: 700 }}"
          srcset="{{ product.featured_media | image_url: width: 400 }} 400w, {{ product.featured_media | image_url: width: 700 }} 700w, {{ product.featured_media | image_url: width: 1000 }} 1000w"
          sizes="(min-width: 990px) 25vw, 50vw"
          alt="{{ product.featured_media.alt | default: product.title | escape }}"
          width="{{ product.featured_media.width }}"
          height="{{ product.featured_media.height }}"
          loading="lazy"
        >
        {%- if product.media.size > 1 -%}
          <img
            class="product-card__media-hover"
            src="{{ product.media[1] | image_url: width: 700 }}"
            alt=""
            width="{{ product.media[1].width }}"
            height="{{ product.media[1].height }}"
            loading="lazy"
          >
        {%- endif -%}
      {%- else -%}
        <span class="placeholder-media">LAMEA_PRODUCT_FRONT_PLACEHOLDER</span>
      {%- endif -%}
    </div>
    {%- if product.compare_at_price > product.price -%}
      <span class="badge badge--accent product-card__badge">{{ 'products.product.on_sale' | t }}</span>
    {%- elsif product.available == false -%}
      <span class="badge product-card__badge">{{ 'products.product.sold_out' | t }}</span>
    {%- endif -%}
  </a>
  <div class="product-card__info">
    {%- render 'star-rating', product: product -%}
    <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- render 'product-price', variant: product.selected_or_first_available_variant, show_compare: settings.show_compare_at_price -%}
  </div>
</div>
