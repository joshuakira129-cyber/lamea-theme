{% comment %} Open Graph / Twitter meta tags {% endcomment %}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }}">
<meta property="og:type" content="{% if template contains 'product' %}product{% else %}website{% endif %}">

{% if page_description %}
  <meta property="og:description" content="{{ page_description | escape }}">
{% elsif settings.seo_default_description %}
  <meta property="og:description" content="{{ settings.seo_default_description | escape }}">
{% endif %}

{% if page_image %}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
{% elsif settings.social_share_image %}
  <meta property="og:image" content="https:{{ settings.social_share_image | image_url: width: 1200 }}">
{% endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | escape }}">
{% if page_description %}
  <meta name="twitter:description" content="{{ page_description | escape }}">
{% endif %}
