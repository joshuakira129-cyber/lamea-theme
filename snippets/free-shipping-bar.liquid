{%- liquid
  assign threshold_cents = settings.free_shipping_threshold | times: 100
  assign remaining_cents = threshold_cents | minus: cart.total_price
  assign progress = cart.total_price | times: 100.0 | divided_by: threshold_cents
  if progress > 1
    assign progress = 1
  endif
  assign remaining_money = remaining_cents | money
-%}
<div class="free-shipping-bar" data-free-shipping-bar>
  {%- if remaining_cents <= 0 -%}
    <p class="free-shipping-bar__message">
      {% render 'icon', icon: 'truck' %}
      {{ 'cart.general.free_shipping_reached' | t }}
    </p>
  {%- else -%}
    <p class="free-shipping-bar__message">
      {{ 'cart.general.free_shipping_progress_html' | t: amount: remaining_money }}
    </p>
  {%- endif -%}
  <div class="free-shipping-bar__track">
    <div class="free-shipping-bar__fill" style="width: {{ progress | times: 100 }}%;"></div>
  </div>
</div>
