{%- comment -%}
  Inline SVG icon library.
  Usage: {% render 'icon', icon: 'cart', class: 'icon' %}
{%- endcomment -%}
{%- liquid
  assign icon_class = class | default: 'icon'
-%}
{%- case icon -%}
  {%- when 'cart' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 12.1a2 2 0 0 0 2 1.6h7.2a2 2 0 0 0 2-1.6L20 8H6.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="20.5" r="1.25"/><circle cx="17" cy="20.5" r="1.25"/></svg>
  {%- when 'search' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M20 20l-4.8-4.8" stroke-linecap="round"/></svg>
  {%- when 'account' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.6"/><path d="M4.5 20c1.4-3.6 4.4-5.6 7.5-5.6s6.1 2 7.5 5.6" stroke-linecap="round"/></svg>
  {%- when 'menu' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17" stroke-linecap="round"/></svg>
  {%- when 'close' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke-linecap="round"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 9l6.5 6.5L18.5 9" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'chevron-left' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'chevron-right' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'plus' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
  {%- when 'minus' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" stroke-linecap="round"/></svg>
  {%- when 'check' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12.5l5 5L20 6.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'play' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" stroke="none"><path d="M8 5.5v13l11-6.5-11-6.5z"/></svg>
  {%- when 'upload' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4.5 15.5v3a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'image' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="M20 16l-4.5-4.5a2 2 0 0 0-2.8 0L4 20" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'video' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="6" width="12" height="12" rx="2"/><path d="M15.5 10l5-2.6v9.2l-5-2.6" stroke-linejoin="round"/></svg>
  {%- when 'trash' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 7h14M9.5 7V5a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v2M7 7l1 12.5a1.5 1.5 0 0 0 1.5 1.4h5a1.5 1.5 0 0 0 1.5-1.4L17 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'truck' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h10v9H3z"/><path d="M13 10h4l3.5 3v2.5H13z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
  {%- when 'shield' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l7 2.6v5.4c0 4.5-3 7.6-7 9-4-1.4-7-4.5-7-9V6.1l7-2.6z" stroke-linejoin="round"/><path d="M9 12l2 2 4-4.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'gift' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="9.5" width="17" height="10" rx="1"/><path d="M3.5 9.5h17v3h-17z"/><path d="M12 9.5v10"/><path d="M12 9.5C10 6 6.5 6 6.5 8.2S9 9.5 12 9.5zM12 9.5c2-3.5 5.5-3.5 5.5-1.3S15 9.5 12 9.5z" stroke-linejoin="round"/></svg>
  {%- when 'frame' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="1.5"/><rect x="7" y="7" width="10" height="10" rx="0.5"/></svg>
  {%- when 'refresh' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12a7.5 7.5 0 0 1 12.9-5.2M19.5 12a7.5 7.5 0 0 1-12.9 5.2" stroke-linecap="round"/><path d="M17.5 4.5v3h-3M6.5 19.5v-3h3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'star' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" stroke="none"><path d="M12 3.5l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17.4l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3.5z"/></svg>
  {%- when 'instagram' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"/></svg>
  {%- when 'tiktok' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" stroke="none"><path d="M14.5 3.5c.5 2 2 3.4 4 3.7v2.6a7 7 0 0 1-4-1.3v6.1a5.4 5.4 0 1 1-4.6-5.4v2.7a2.7 2.7 0 1 0 1.9 2.6V3.5h2.7z"/></svg>
  {%- when 'facebook' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 21v-7h2.4l.4-3H14V9c0-.9.3-1.6 1.7-1.6H17V4.7c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1V11H8v3h2.6v7H14z" fill="currentColor" stroke="none"/></svg>
  {%- when 'pinterest' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" stroke="none"><path d="M12 3.5a8.5 8.5 0 0 0-3.1 16.4c-.05-.7-.1-1.8 0-2.6l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.5 2.2-.8 3.4-.2.9.5 1.7 1.4 1.7 1.7 0 2.9-2.2 2.9-4.7 0-2-1.3-3.4-3.7-3.4-2.7 0-4.4 2-4.4 4.2 0 .8.2 1.3.6 1.8.2.2.2.3.1.5l-.2.9c-.1.3-.3.4-.5.2-1.5-.6-2.2-2.2-2.2-4 0-3 2.5-6.5 7.4-6.5 4 0 6.6 2.9 6.6 6 0 4.1-2.3 7.2-5.6 7.2-1.1 0-2.2-.6-2.5-1.3l-.7 2.8c-.2.9-.7 1.9-1.1 2.6.9.3 1.9.4 2.9.4A8.5 8.5 0 0 0 12 3.5z"/></svg>
  {%- when 'youtube' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="3"/><path d="M10.5 9.5l5 2.5-5 2.5z" fill="currentColor" stroke="none"/></svg>
  {%- else -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/></svg>
{%- endcase -%}
