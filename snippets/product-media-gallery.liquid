{%- comment -%} Accepts: product {%- endcomment -%}
<div class="product-gallery" data-product-gallery>
  <div class="product-gallery__main" data-gallery-main tabindex="0" aria-label="Galerie du produit {{ product.title }}">
    {%- if product.media.size > 0 -%}
      {%- for media in product.media -%}
        <div class="aspect-ratio product-gallery__slide" data-gallery-slide data-media-id="{{ media.id }}" {% if media.media_type == 'image' %}data-magnify{% endif %}>
          {%- case media.media_type -%}
            {%- when 'video' or 'external_video' -%}
              <div class="product-gallery__video-wrap">
                {{ media | media_tag: controls: true, image_size: '1200x' }}
              </div>
            {%- when 'model' -%}
              {{ media | media_tag: image_size: '1200x' }}
            {%- else -%}
              <img
                src="{{ media | image_url: width: 1200 }}"
                srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w"
                sizes="(min-width: 990px) 46vw, 100vw"
                alt="{{ media.alt | default: product.title | escape }}"
                width="{{ media.width }}"
                height="{{ media.height }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                fetchpriority="{% if forloop.first %}high{% else %}auto{% endif %}"
              >
          {%- endcase -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="aspect-ratio product-gallery__slide">
        <span class="placeholder-media">LAMEA_PRODUCT_FRONT_PLACEHOLDER</span>
      </div>
    {%- endif -%}
  </div>

  {%- if product.media.size > 1 -%}
    <div class="product-gallery__controls hide-mobile">
      <button type="button" class="icon-link product-gallery__arrow" data-gallery-prev aria-label="{{ 'general.accessibility.previous_slide' | t }}">{% render 'icon', icon: 'chevron-left' %}</button>
      <button type="button" class="icon-link product-gallery__arrow" data-gallery-next aria-label="{{ 'general.accessibility.next_slide' | t }}">{% render 'icon', icon: 'chevron-right' %}</button>
    </div>

    <div class="product-gallery__thumbs" role="tablist" aria-label="Miniatures">
      {%- for media in product.media -%}
        <button
          type="button"
          class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
          data-gallery-thumb
          data-media-id="{{ media.id }}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        >
          {%- if media.preview_image -%}
            <img src="{{ media.preview_image | image_url: width: 160 }}" alt="" width="64" height="64" loading="lazy">
          {%- endif -%}
          {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
            <span class="product-gallery__thumb-icon">{% render 'icon', icon: 'play' %}</span>
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>

    <div class="product-gallery__dots hide-desktop" aria-hidden="true">
      {%- for media in product.media -%}
        <span class="product-gallery__dot{% if forloop.first %} is-active{% endif %}" data-gallery-dot data-media-id="{{ media.id }}"></span>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
