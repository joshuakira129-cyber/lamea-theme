<section class="account-page page-width section-padding">
  <div class="account-card" data-reveal="fade">
    <h1 class="account-card__title font-heading">{{ 'customer.register.title' | t }}</h1>

    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <ul class="account-card__errors" role="alert">
          {%- for field in form.errors -%}
            <li>{{ form.errors.messages[field] }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="field">
        <label for="FirstName">{{ 'customer.register.first_name' | t }}</label>
        <input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name">
      </div>
      <div class="field">
        <label for="LastName">{{ 'customer.register.last_name' | t }}</label>
        <input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name">
      </div>
      <div class="field">
        <label for="Email">{{ 'customer.register.email' | t }}</label>
        <input type="email" name="customer[email]" id="Email" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="CreatePassword">{{ 'customer.register.password' | t }}</label>
        <input type="password" name="customer[password]" id="CreatePassword" autocomplete="new-password" required>
      </div>

      <button type="submit" class="button button--accent button--full">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}

    <p class="account-card__footer">
      <a href="{{ routes.account_login_url }}" class="link">{{ 'customer.login_page.sign_in' | t }}</a>
    </p>
  </div>
</section>

{% style %}
.account-page {
  display: flex;
  justify-content: center;
}

.account-card {
  width: 100%;
  max-width: 26rem;
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.account-card__title {
  font-size: 1.9rem;
  text-align: center;
  margin-bottom: 0.5rem;
}

.account-card__errors {
  color: #b23b3b;
  font-size: 0.85rem;
}

.account-card__footer {
  text-align: center;
  font-size: 0.9rem;
}
{% endstyle %}
