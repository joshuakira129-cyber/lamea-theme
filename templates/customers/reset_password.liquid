<section class="account-page page-width section-padding">
  <div class="account-card" data-reveal="fade">
    <h1 class="account-card__title font-heading">{{ 'customer.reset_password.title' | t }}</h1>
    <p class="text-muted" style="text-align:center;">{{ 'customer.reset_password.subtext' | t }}</p>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <ul class="account-card__errors" role="alert">
          {%- for field in form.errors -%}
            <li>{{ form.errors.messages[field] }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="field">
        <label for="ResetPassword">{{ 'customer.register.password' | t }}</label>
        <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="ResetPasswordConfirmation">Confirmer le mot de passe</label>
        <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirmation" autocomplete="new-password" required>
      </div>

      <button type="submit" class="button button--accent button--full">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% style %}
.account-page { display: flex; justify-content: center; }
.account-card { width: 100%; max-width: 26rem; display: flex; flex-direction: column; gap: 1.1rem; }
.account-card__title { font-size: 1.9rem; text-align: center; margin-bottom: 0.5rem; }
.account-card__errors { color: #b23b3b; font-size: 0.85rem; }
{% endstyle %}
